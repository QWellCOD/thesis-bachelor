#!/usr/bin/env bash
# Blocks commits with staged files larger than 10 MiB.
# Activate once per clone: git config core.hooksPath .githooks

limit=$((10 * 1024 * 1024))
too_big=()

while IFS= read -r -d '' file; do
  size=$(git cat-file -s ":$file" 2>/dev/null) || continue
  if [ "$size" -gt "$limit" ]; then
    too_big+=("$file ($((size / 1024 / 1024)) MiB)")
  fi
done < <(git diff --cached --name-only --diff-filter=AM -z)

if [ ${#too_big[@]} -gt 0 ]; then
  echo "Commit blocked: these files are larger than 10 MiB:" >&2
  printf '  %s\n' "${too_big[@]}" >&2
  echo "Fix: reduce the files or store them outside Git in approved storage." >&2
  exit 1
fi
