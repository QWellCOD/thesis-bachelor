# latexmk output directory (PDF, auxiliary files, minted cache)
/build/

# Auxiliary files, in case something is compiled outside build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.lol
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.glsdefs
*.xdv
*.dvi
*-SAVE-ERROR
_minted*/

# latexdiff output (scripts/latexdiff.ps1)
/main-diff.tex

# latexindent
indent.log
*.bak[0-9]*
__latexindent_temp*

# OS and Office lock files
Thumbs.db
desktop.ini
~$*
.~lock.*#
