* text=auto eol=lf

# Binary files are stored directly in Git without content filters.
# Images
*.png  binary -filter
*.jpg  binary -filter
*.jpeg binary -filter
*.gif  binary -filter
*.bmp  binary -filter
*.tif  binary -filter
*.tiff binary -filter
*.webp binary -filter
# PDF and vector/print formats
*.pdf  binary -filter
*.eps  binary -filter
*.psd  binary -filter
*.ai   binary -filter
# Office and Visio
*.docx binary -filter
*.xlsx binary -filter
*.pptx binary -filter
*.vsdx binary -filter
# Archives, video, fonts
*.zip  binary -filter
*.7z   binary -filter
*.mp4  binary -filter
*.mov  binary -filter
*.ttf  binary -filter
*.otf  binary -filter
