{
  // Build: latexmk reruns only the steps that are needed; all options live in .latexmkrc
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": ["%DOC%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (.latexmkrc)",
      "tools": ["latexmk"]
    }
  ],
  // Must match $out_dir in .latexmkrc
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.clean.args": ["-c", "%TEX%"],
  "latex-workshop.latex.search.rootFiles.include": ["main.tex"],

  // Word count in the status bar; -inc follows \include'd chapters
  "latex-workshop.texcount.args": ["-utf8", "-inc"],
  "latex-workshop.texcount.autorun": "onSave",

  // Formatting with latexindent; log goes to a temp dir instead of the project
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.args": [
    "-c",
    "%TMPDIR%/",
    "-l=%WORKSPACE_FOLDER%/latexindent.yaml",
    "%TMPFILE%",
    "-y=defaultIndent: '%INDENT%'"
  ],

  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },
  "[bibtex]": {
    "editor.formatOnSave": false
  },
  "files.eol": "\n",
  "files.watcherExclude": {
    "**/build/**": true
  },
  "search.exclude": {
    "**/build": true
  },
  // Generated by Zotero (Better BibTeX auto-export); manual edits would be overwritten
  "files.readonlyInclude": {
    "references.bib": true
  },

  // LTeX+ spelling and grammar check
  "ltex.language": "de-DE",
  "ltex.additionalRules.motherTongue": "de-DE",
  "ltex.latex.commands": {
    "\\gls{}": "dummy",
    "\\Gls{}": "dummy",
    "\\glspl{}": "pluralDummy",
    "\\Glspl{}": "pluralDummy",
    "\\acrshort{}": "dummy",
    "\\acrlong{}": "dummy",
    "\\acrfull{}": "dummy",
    "\\mintinline{}{}": "dummy"
  },
  "ltex.latex.environments": {
    "minted": "ignore"
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
    { "file": ".github/commit-instructions.md" }
  ],
}
