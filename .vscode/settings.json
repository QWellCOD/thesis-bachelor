{
  // Build: all latexmk options live in .latexmkrc (same result in VS Code and terminal)
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": ["%DOC%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (.latexmkrc)",
      "tools": ["latexmk"]
    }
  ],
  // Must match $out_dir in .latexmkrc
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.clean.args": ["-c", "%TEX%"],

  // Formatting with latexindent; log goes to a temp dir instead of the project
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.args": [
    "-c",
    "%TMPDIR%/",
    "-l=%WORKSPACE_FOLDER%/latexindent.yaml",
    "%TMPFILE%",
    "-y=defaultIndent: '%INDENT%'"
  ],

  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },
  "[bibtex]": {
    "editor.formatOnSave": false
  },
  "files.eol": "\n",
  // Generated by Zotero (Better BibTeX auto-export); manual edits would be overwritten
  "files.readonlyInclude": {
    "references.bib": true
  },

  // LTeX+ spelling and grammar check
  "ltex.language": "de-DE",
  "ltex.additionalRules.motherTongue": "de-DE",
  "ltex.latex.commands": {
    "\\gls{}": "dummy",
    "\\Gls{}": "dummy",
    "\\glspl{}": "pluralDummy",
    "\\Glspl{}": "pluralDummy",
    "\\acrshort{}": "dummy",
    "\\acrlong{}": "dummy",
    "\\acrfull{}": "dummy",
    "\\mintinline{}{}": "dummy"
  },
  "ltex.latex.environments": {
    "minted": "ignore"
  }
}
